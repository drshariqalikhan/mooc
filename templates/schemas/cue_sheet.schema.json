{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LectureCueSheet",
  "type": "object",
  "required": ["lecture_title", "scenes"],
  "properties": {
    "lecture_title": { "type": "string" },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "scene_type", "narration", "visual_cue"],
        "properties": {
          "scene_id": { "type": "integer" },
          "scene_type": {
            "type": "string",
            "enum": [
              "kinetic_text",
              "concept_morph",
              "split_comparison",
              "diagram_flow"
            ]
          },
          "narration": {
            "type": "string",
            "description": "Spoken text read by F5-TTS"
          },
          "visual_cue": {
            "type": "object",
            "properties": {
              "headline": { "type": "string" },
              "key_phrases": {
                "type": "array",
                "items": { "type": "string" }
              },
              "items_left": {
                "type": "array",
                "items": { "type": "string" }
              },
              "items_right": {
                "type": "array",
                "items": { "type": "string" }
              },
              "nodes": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
